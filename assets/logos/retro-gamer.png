border-radius: var(--flw-border-radius-var-responsive-featured-list-item-image);
}
/* latest news end */
@media screen and (min-width:700px) {
body.gamesradar-v2.flexi-page .widget.flw-responsive-top-featured-list {
height: fit-content;
position: sticky;
top: 0;
margin-top: 10px !important;
}
}
@media screen and (max-width:700px) {
body.flexi-page .widget.flw-custom-widget-top-curated, body.gamesradar-v2.flexi-page .widget.flw-responsive-top-featured-list .wdn-fte-lists-list {
