text-transform: var(--flw-text-transform-var-responsive-featured-list-item);
color: var(--flw-color-var-responsive-featured-list-item);
letter-spacing: var(--flw-letter-spacing-var-responsive-featured-list-item);
}
body.gamesradar-v2.flexi-page .widget.flw-responsive-top-featured-list .wdn-listv2-item-lists .wdn-listv2-item a.wdn-listv2-item-link {
display: flex;
gap: 14px;
}
body.gamesradar-v2.flexi-page .widget.flw-responsive-top-featured-list .wdn-listv2-item-lists .wdn-listv2-item a .v2-listing-image-layout {
display: var(--flw-display-var-responsive-featured-list-item-image);
