}
body.flexi-page .widget.flw-custom-recirculation-inline-list aside[data-component-name*="Recirculation"]:not([data-recirculation-type="pretty-verdict"]):before {
content: "";
border-top: 1px solid #DD4F19;
height: 1px;
display: block;
position: absolute;
width: 100%;
top: 23px;
right: 0;
}
body.flexi-page .widget.flw-custom-recirculation-inline-list aside[data-component-name*="Recirculation"] img {
border-radius: 6px !important;
}
