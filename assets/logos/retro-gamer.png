body.flexi-page.gamesradar-v2 .widget.flw-landing-custom-curated-content .feature-block-item-wrapper:not(.item-1) {
--flw-m-var-item-label: 14px 0px 0px 126px !important;
}
body.flexi-page.gamesradar-v2 .widget.flw-landing-custom-curated-content .feature-block-item-wrapper:not(.item-1) .feature-block-item {
