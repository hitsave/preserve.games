}
body.gamesradar-v2.flexi-page .widget.flw-responsive-top-featured-list .wdn-listv2-item-lists .wdn-listv2-item a .v2-listing-image-layout .v2-listing-image-wrapper {
padding-top: 100% !important;
}
body.gamesradar-v2.flexi-page .widget.flw-responsive-top-featured-list .wdn-listv2-item-lists .wdn-listv2-item a .v2-listing-image-layout .v2-listing-image-wrapper img {
