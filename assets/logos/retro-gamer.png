}
.kiosq-my-account-manage-button {
display: flex;
justify-content: center;
align-items: center;
padding: 2px 20px;
width: 188px;
height: 40px;
background-color: var(--flexi-brand_color_2);
border: 1px solid var(--flexi-brand_color_2);
