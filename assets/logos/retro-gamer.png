line-height: 15px;
margin-bottom: 3px;
text-align: center;
}
.kiosq-my-account-subscription-status-data {
font-size: 12px;
line-height: 15px;
margin-bottom: 3px;
text-align: center;
}
.kiosq-my-account-stay-in-touch-widget {
min-height: 400px;
}
.kiosq-my-account-stay-in-touch-title-content {
