margin: var(--flw-m-var-responsive-featured-list-item);
padding: var(--flw-p-var-responsive-featured-list-item);
border: var(--flw-border-var-responsive-featured-list-item);
border-width: var(--flw-border-width-var-responsive-featured-list-item);
border-image: var(--flw-border-image-var-responsive-featured-list-item);
