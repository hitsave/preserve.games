body.flexi-page.gamesradar-v2 .widget.flw-landing-custom-curated-content .feature-block-item-wrapper:not(.item-1) .feature-block-item .image-remove-flow-width-setter .image-remove-reflow-container {
padding-top: 100% !important;
}
body.flexi-page.gamesradar-v2 .widget.flw-landing-custom-curated-content .feature-block-item-wrapper:not(.item-1) .article-name {
margin-top: 17px !important;
}
body.gamesradar-v2.flexi-page .widget.flw-custom-widget-video-page-title {
--flw-font-weight-var-hero-widget-title: 700 !important;
}
}
/* custom classes end */
body.flexi-page.gamesradar-v2 .flw-custom-dark-landing-page #article-body {
filter: contrast(0.8) invert(1);
}
body.flexi-page.gamesradar-v2 .flw-custom-dark-landing-page div#article-body img,
body.flexi-page.gamesradar-v2 .flw-custom-dark-landing-page div#article-body .icon-star,
body.flexi-page.gamesradar-v2 .flw-custom-dark-landing-page div#article-body [class*="hawk-merchant-"],
body.flexi-page.gamesradar-v2 .flw-custom-dark-landing-page div#article-body .jwplayer__wrapper,
