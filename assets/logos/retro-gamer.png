}
}
/*My account*/
.flexi-page-my-account #affiliate-disclaimer p{
color: white;
}
.flexi-page-my-account div#my-account-v3-full-page-1 {
background: white;
}
@media screen and (max-width: 700px) {
.flexi-page-my-account #top-leaderboard {
margin-top: 0px !important;
}
.flexi-page-my-account #affiliate-disclaimer {
top: 34px !important;
}
.flexi-page-my-account #affiliate-disclaimer {
color: black !important;
}
}
