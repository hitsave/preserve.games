body.flexi-page .widget.flw-responsive-top-featured-list .wdn-listv2-item-lists .wdn-listv2-item a .v2-listing-image-layout {
margin-top: 0px !important;
margin-bottom: 0px !important;
}
body.flexi-page .widget.flw-responsive-top-featured-list .wdn-listv2-item-lists .wdn-listv2-item a .v2-listing-image-layout img {
display: block;
}
body.flexi-page .widget.flw-responsive-top-featured-list .wdn-listv2-item-lists .wdn-listv2-item a .v2-listing-image-layout {
border-radius: var(--flw-border-radius-var-md);
}
body.flexi-page .widget.flw-responsive-top-featured-list .wdn-listv2-item-lists {
margin-top: 28px !important;
}
body.gamesradar-v2.flexi-page .widget.flw-responsive-top-featured-list,
body.gamesradar-v2.flexi-page .widget.flw-responsive-top-featured-list.wdn-fte-lists-list {
margin-top: 0px !important;
}
body.flexi-page .widget.flw-custom-widget-top-curated {
--brand-layout-padding-bottom: 0px !important;
--flw-sm-mb-var-widget-title: 16px !important;
--flw-sm-pt-var-hero-content-wrapper: 20px !important;
--flw-sm-pb-var-hero-content-wrapper: 20px !important;
--flw-sm-pl-var-hero-content-wrapper: 24px !important;
--flw-sm-pr-var-hero-content-wrapper: 24px !important;
--flw-sm-mb-var-hero-content-title: 0px !important;
--brand-layout-padding-top: 0px !important;
--flw-border-width-var-responsive-featured-list-item: 0px 0px 25px 0px !important;
margin-top: 0px !important;
}
body.flexi-page .widget.flw-custom-tabbed-widget, body.flexi-page .widget.flw-custom-widget-socials {
--brand-layout-padding-right: 0px !important;
--brand-layout-padding-left: 0px !important;
