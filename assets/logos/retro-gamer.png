--flw-m-var-item-label: calc((100vw - 15px)/1.77) 25px 0px !important ;
position: absolute;
top: 0;
}
body.gamesradar-v2.flexi-page .widget.flw-landing-custom-curated-content .feature-block-item-wrapper:not(.item-1) .category-link {
position: absolute;
top: 0;
}
body.gamesradar-v2.flexi-page .widget.flw-custom-widget-newsletter-page {
margin-top: 0px !important;
}
body.gamesradar-v2.flexi-page .widget.flw-custom-widget-newsletter-page .widget-header {
margin: 0px;
}
body [data-component-name="Nav:Mobile"] li:first-of-type a span {
visibility: visible !important;
text-transform: capitalize;
}
body.gamesradar-v2.flexi-page:not(.flexi-home) #main .widget:not(:empty):not(:has(.wcp-item-content:empty)) {
--brand-layout-margin-bottom: 28px !important;
--brand-layout-padding-top: 0px !important;
--brand-layout-padding-bottom: 0px !important;
--brand-layout-padding-left: 16px !important;
--brand-layout-padding-right: 16px !important;
}
body.gamesradar-v2.flexi-page .widget.flw-custom-widget-subcategory-h2 {
--flw-sm-size-var-widget-title: 20px !important;
--flw-sm-line-height-var-widget-title: 26px !important;
--flw-sm-font-weight-var-widget-title: 600px !important;
--flw-size-var-sub-category-list-item: 16px !important;
--flw-px-var-sub-category-list-item: 16px !important;
--brand-layout-margin-left: 15px;
--brand-layout-margin-right: 15px;
width: calc(100% - 30px);
background-color: var(--color-shark-grey);
padding: 16px 14px !important;
}
body.gamesradar-v2.flexi-page .widget.flw-custom-hero-landscape-border-radius .wdn-listv2-item-hero :where(.v2-listing-image-wrapper, .wdn-listv2-item-link) {
