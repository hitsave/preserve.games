}
body.gamesradar-v2.flexi-page .widget.flw-article-h2-title :where(#article-body, .article-body > div) > h2:not(.featured__title):not(.article-body__section):before,
body.gamesradar-v2.flexi-page .widget.flw-article-h2-title :where(#article-body, .article-body > div) > h2:not(.featured__title):not(.article-body__section):after {
display: none;
}
