/* --flexi-page-layout-- */
@layer legacy { /* top curated */
body.flexi-page .widget.flw-custom-widget-top-curated {
--flw-color-var-hero-content-title: var(--color-storm-dust-light) !important;
--flw-display-var-list-item-label: block !important;
--flw-sm-display-var-list-item-label: block !important;
--flw-mb-var-hero-content-title: 0px !important;
--flw-pt-var-hero-content-wrapper:28px !important;
--flw-pb-var-hero-content-wrapper: 28px !important;
--flw-pl-var-hero-content-wrapper: 28px !important;
--flw-pr-var-hero-content-wrapper: 28px !important;
--brand-layout-padding-right: 0px !important;
--brand-layout-padding-left: 0px !important;
}
body.flexi-page .widget.flw-custom-widget-top-curated .wdn-listv2-item-lists .wdn-listv2-item {
--flw-pt-var-listing-title: 12px !important;
--flw-m-var-item-label: 16px 16px 0px !important;
}
body.flexi-page .widget.flw-custom-widget-top-curated .wdn-listv2-item-content-title-label {
top: 0;
left: 16px;
}
body.flexi-page .widget.flw-custom-widget-top-curated {
position: relative !important;
}
body.flexi-page .widget.flw-custom-widget-top-curated > div:not(:first-of-type) {
margin-top: 0px !important;
position: static !important;
}
/* top curated */
/*latest news */
body.flexi-page .widget.flw-responsive-top-featured-list {
--brand-layout-padding-right: 0px !important;
--brand-layout-padding-left: 0px !important;
}
body.flexi-page .widget.flw-responsive-top-featured-list .wdn-listv2-item-content-title-label {
display: none;
}
body.flexi-page .widget.flw-responsive-top-featured-list .wdn-listv2-item-lists {
counter-reset: item;
}
body.flexi-page .widget.flw-responsive-top-featured-list .wdn-listv2-item-lists > .wdn-listv2-item {
counter-increment: item;
}
body.flexi-page .widget.flw-responsive-top-featured-list .wdn-listv2-item-lists > .wdn-listv2-item .wdn-listv2-item-link:before{
content: counter(item);
font-size: 24px;
line-height: 26px;
font-weight: 900;
color: #F6F7F9;
}
body.gamesradar-v2.flexi-page .widget.flw-responsive-top-featured-list
{
background-color: var(--flw-bg-var-responsive-featured-list);
padding: var(--flw-p-var-responsive-featured-list);
border-radius: var(--flw-border-radius-var-responsive-featured-list);
top: -15px;
right: 0px;
left: unset !important;
height: fit-content !important;
}
body.gamesradar-v2.flexi-page .widget.flw-responsive-top-featured-list .widget-title {
margin: var(--flw-m-var-responsive-featured-list-title);
padding: var(--flw-p-var-responsive-featured-list-title);
border: var(--flw-border-var-responsive-featured-list-title);
font-size: var(--flw-size-var-responsive-featured-list-title) !important;
line-height: var(--flw-line-height-var-responsive-featured-list-title);
