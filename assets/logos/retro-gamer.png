gap: 30px;
}
.kiosq-my-account {
margin-top: 20px;
}
.kiosq-my-account .show {
display: block;
}
.kiosq-my-account .hide {
display: none;
}
.kiosq-my-account-user-infos-widget {
display: flex;
align-items: center;
padding: 20px 10px;
background-color: #ededed;
gap: 5px;
height: 60px;
