--nav-item-text-decoration: none !important;
}
body.gamesradar-v2.flexi-page ul[data-component-name="Nav:Desktop:ItemList"] li > span, body.gamesradar-v2.flexi-page ul[data-component-name="Nav:Desktop:ItemList"] > li > a:has( + ul){
