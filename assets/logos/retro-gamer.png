<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
try {
const campaignConfig = {
'GamesRadar+': {
logoString: '<img alt="GamesRadar+ logo" loading="eager" src="https://cdn.mos.cms.futurecdn.net/DvxFWNbCk8Zq5hfNPhP6BP.gif" class="max-w-64 sm:max-w-full h-[40px] sm:h-[50px] w-auto"/>',
hoverText: "What's this? GamesRadar+ has partnered with Gothic 1 remake to celebrate the game's release.",
usDates: {
start: new Date('2026-06-05T17:00:00Z'),
end: new Date('2026-06-06T16:59:00Z')
}
},
'PC Gamer': {
logoString: '<img alt="PC Gamer logo" loading="eager" src="https://cdn.mos.cms.futurecdn.net/vvfe7pevxCtyTzb5QZxHiY.gif" class="commercial-logo-pcgamer max-w-40 sm:max-w-full h-[30px] sm:h-[50px] w-auto"/>',
hoverText: "What's this? PC Gamer has partnered with Gothic 1 remake to celebrate the game's release.",
usDates: {
start: new Date('2026-06-06T07:01:00Z'),
end: new Date('2026-06-07T03:59:00Z')
}
}
};
const config = campaignConfig['GamesRadar+'];
if (!config) return;
const logoEl = document.querySelector('#publisherDetails picture');
if (!logoEl) return;
const now = new Date();
const hasUSCookie = document.cookie.indexOf('FTR_Country_Code=US') > -1 || document.cookie.indexOf('FTR_User_Defined_Country_Code=US') > -1;
if (!(config.usDates.start < now && now < config.usDates.end && hasUSCookie && document.body.classList.contains('vertical-home'))) {
return;
}
logoEl.innerHTML = config.logoString;
const hoverDiv = document.createElement('div');
hoverDiv.textContent = config.hoverText;
hoverDiv.classList.add('hover-text');
logoEl.parentNode.insertBefore(hoverDiv, logoEl);
logoEl.addEventListener('mouseover', function() {
hoverDiv.style.display = 'block';
});
logoEl.addEventListener('mouseout', function() {
hoverDiv.style.display = 'none';
});
} catch (e) {
}
});
</script>
<style data-layerless-source="true">@layer legacy { 
.hover-text {
display: none;
position: absolute;
top: 100%;
width: 370px;
height: auto;
padding: 10px 15px;
background: #0F1618;
color: #fff;
border-radius: 5px;
z-index: 999;
line-height: 24px;
font-size: 14px;
text-align: left;
}
.vanilla-centered-header .logo .hover-text {
top: 103%;
left: 50%;
transform: translate(-50%);
text-align: center;
}
@media (max-width: 699px) {
#publisherDetails picture .commercial-logo-pcgamer {
max-height: 30px;
}
.hover-text {
width: 280px;
font-size: 12px;
}
}
 }</style>
