line-height: 24px !important;
}
body.gamesradar-v2.flexi-page ul[data-component-name="Nav:Desktop:ItemList"][x-data="DesktopItemList(2)"] {
border-radius: 24px;
padding: 10px 20px 28px !important;
}
body.gamesradar-v2.flexi-page [data-component-name="Nav:Desktop"] [data-component-name="Nav:Desktop:ItemList"] ul li a {
--nav-item-font-size: 16px !important;
--nav-item-font-weight: 600 !important;
