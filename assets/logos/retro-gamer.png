body.flexi-page.gamesradar-v2 .widget.flw-landing-custom-curated-content .feature-block-item-wrapper {
--flw-sm-ml-var-hero-content-title: 24px !important;
--flw-sm-mt-var-hero-content-title: 20px !important;
--flw-sm-mb-var-hero-content-title: 20px !important;
--flw-sm-mr-var-hero-content-title: 24px !important;
--flw-sm-display-var-list-item-label: block !important;
