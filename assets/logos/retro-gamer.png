border-bottom-left-radius: var(--flw-border-radius-var-lg);
}
body.gamesradar-v2.flexi-page .widget.flw-custom-widget-listing-hero {
--brand-layout-margin-bottom: 0px !important;
}
body.gamesradar-v2.flexi-page .flw-custom-article-hero-border-radius [class*="hero-image"] img {
border-radius: 0px !important;
}
body [data-component-name="Nav:Mobile"] li .meganav-mobile-item-list :where(a, button){
font-family: var(--font-family-main) !important;
font-weight: 400 !important;
font-size: 16px !important;
line-height: 24px !important;
padding: 10px 16px 10px 26px !important;
}
body [data-component-name="Nav:Mobile"] li :where(a, button) svg {
display: none !important;
}
body [data-component-name="Nav:Mobile"] li:not(:first-child) :where(a, button):has(svg):after {
content: "\27E9";
transform: rotate(90deg);
margin-left: auto;
font-size: 16px;
}
body [data-component-name="Nav:Mobile"] li:not(:has(> ul.hidden)) > :where(a, button):has(svg):after {
transform: rotate(-90deg);
font-size: 16px;
}
body.flexi-page .widget.flw-custom-author-page-author-bio {
--flw-p-var-article-author-bio-container: 0px !important;
