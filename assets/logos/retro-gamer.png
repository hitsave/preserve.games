body.gamesradar-v2.flexi-page .widget.flw-article-button-component a.button.button--text {
--flw-bg-color-var-article-button-component: transparent !important;
--flw-color-var-article-button-component: #1b1b1b !important;
--flw-border-color-var-article-button-component: transparent !important;
--flw-border-width-var-article-button-component: 0px !important;
--flw-border-radius-var-article-button-component: none !important;
}
/* header flw */
body .primary-nav [data-component-name="SiteHeader:Masthead"] > div {
height: var(--flw-height-site-master-head) !important;
padding: var(--flw-p-site-master-head) !important;
width: var(--flw-width-site-master-head) !important;
max-width: var(--flw-max-width-site-master-head) !important;
}
body [data-component-name="Social:Icons"] a > svg > circle, body [data-component-name="Social:Icons"] a > svg > g:first-of-type > path{
fill: var(--flw-fill-social-icons-header-circle);
}
body [data-component-name="Social:Icons"] a > svg > path, body [data-component-name="Social:Icons"] a > svg > g > path {
fill: var(--flw-fill-social-icons-header-path);
}
body [data-component-name="Social:Icons"] a > svg > path, body [data-component-name="Social:Icons"] a.icon-twitter > svg > g:not(:first-of-type) path {
fill: var(--flw-fill-social-icons-header-path);
}
[data-component-name="SiteHeader:Masthead"] > div [data-component-name="Region:LocaleSelector"]:after,
[data-component-name="SiteHeader:Masthead"] > div #auth-in-nav-header:after,
[data-component-name="SiteHeader:Masthead"] > div [data-component-name="Viafoura:Notification:TrayBell"]:after {
content: "";
border: 1px solid #8792A9;
height: 14px;
position: absolute;
right: 0;
top: 15px;
}
[data-component-name="SiteHeader:Masthead"] > div [data-component-name="Region:LocaleSelector"] {
background: var(--color-shark-dark);
border-top-left-radius: 24px;
padding-left: 10px !important;
border-bottom-left-radius: 24px;
margin-left: 20px !important;
border-right: 0px !important;
padding-right: 10px !important;
padding-top: 0px !important;
padding-bottom: 0px !important;
position: relative;
}
[data-component-name="SiteHeader:Masthead"] > div [data-component-name="Region:LocaleSelector"] button span {
font-family: var(--font-family-main);
font-size: 12px !important;
}
[data-component-name="SiteHeader:Masthead"] > div #auth-in-nav-header {
height: 100%;
background: var(--color-shark-dark);
padding: 0px 10px;
}
[data-component-name="SiteHeader:Masthead"] > div #auth-in-nav-header span {
font-family: var(--font-family-main);
font-size: 12px !important;
}
[data-component-name="SiteHeader:Masthead"] > div [data-component-name="Viafoura:Notification:TrayBell"] {
background: var(--color-shark-dark);
position: relative;
}
[data-component-name="SiteHeader:Masthead"] > div [data-component-name="SiteHeader:Masthead:SearchBar"] {
display: flex;
align-items: center;
height: 100%;
background: var(--color-shark-dark);
border-top-right-radius: 24px;
border-bottom-right-radius: 24px;
padding: 0px 10px;
}
[data-component-name="SiteHeader:Masthead"] > div [data-component-name="SiteHeader:Masthead:SearchBar"] .searchText {
font-size: 12px !important;
font-family: var(--font-family-main);
}
body [data-component-name="SiteHeader:Masthead:Logo"] img {
--logo-height-desktop: 44px !important;
}
/* Trending bar container */
body.gamesradar-v2.flexi-page #trendingBar {
padding: 0 !important;
max-width: 100vw;
--trending-bar-background-color: #3B4151 !important;
color: white !important;
}
/* Remove wrapper border */
body.gamesradar-v2.flexi-page #trendingBar .trending__wrapper {
border: none !important;
}
/* Trending label */
body.gamesradar-v2.flexi-page #trendingBar span {
font-size: 12px !important;
line-height: 16px !important;
font-weight: 700 !important;
font-family: var(--font-family-main) !important;
margin-top: 13px !important;
}
/* Trending links */
body.gamesradar-v2.flexi-page #trendingBar li a {
font-size: 12px !important;
line-height: 16px;
font-family: var(--font-family-main);
font-weight: 600;
cursor: pointer;
}
/* Hover state */
body.gamesradar-v2.flexi-page #trendingBar li a:hover {
color: white !important;
}
/* Mobile styles */
@media screen and (max-width: 700px) {
body.gamesradar-v2.flexi-page #trendingBar li a {
font-style: italic;
font-weight: 400;
}
}
body.gamesradar-v2.flexi-page .trending-bar-container {
padding: 0px;
width: 100%;
z-index: 3;
position: relative;
}
body.gamesradar-v2.flexi-page .trending-bar-container .trending__wrapper {
display: flex;
justify-content: center;
align-items: center;
}
body.gamesradar-v2.flexi-page .trending-bar-container .trending__wrapper .trending__nav {
width: fit-content;
}
body.gamesradar-v2.flexi-page .slice-container-trending {
--trending__border-top-width: 0px !important;
--trending-background-color: #3B4151 !important;
--trending-label-color: var(--color-white) !important;
}
body.gamesradar-v2.flexi-page .slice-container-trending .trending__wrapper {
border-bottom: 0px;
padding: 2px 0px;
}
body.gamesradar-v2.flexi-page .slice-container-trending .trending__wrapper .trending__item {
margin: 0px 6px;
padding: 0px 8px;
}
body.gamesradar-v2.flexi-page .slice-container-trending .trending__wrapper .trending__label:after {
content:":";
}
body.gamesradar-v2.flexi-page .slice-container-trending .trending__wrapper .trending__item .trending__link {
font-size: 12px;
line-height: 16px;
font-family: var(--font-family-main);
font-weight: 600;
color: #fff;
}
body.gamesradar-v2.flexi-page [data-component-name="Nav:Desktop"] {
--nav-item-bg-color: #1b1b1b !important;
--nav-item-list-bg-color: #1b1b1b !important;
